# Normalise to LF in the repository; check out native on Windows.
* text=auto

*.gs   text eol=lf
*.js   text eol=lf
*.ts   text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.html text eol=lf
*.css  text eol=lf
*.svg  text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf

*.png  binary
*.jpg  binary
*.jpeg binary
*.pdf  binary
*.woff binary
*.woff2 binary
*.ttf  binary
